PORT=18787
# Required to open the in-app Admin panel. Use a long, unique password.
NOOK_ADMIN_PASSWORD=change-this-before-starting

# Optional: Default LLM Provider (openai, groq, gemini, or custom).
# If omitted, Nook automatically selects the provider with a configured API Key.
NOOK_DEFAULT_PROVIDER=groq

# Vercel: add whichever providers you want to expose in the front-end switch.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional custom OpenAI-compatible provider.
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_MODEL=

# Optional character-specific system prompts:
NOOK_SYSTEM_PROMPT_MIA=You are Mia, a helpful, concise assistant.
NOOK_SYSTEM_PROMPT_NORMAN=You are Norman, a knowledgeable, friendly jungle guide and assistant.
# Optional general fallback system prompt override:
# NOOK_SYSTEM_PROMPT=
