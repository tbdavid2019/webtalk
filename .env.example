PORT=18787
# Required only while using the legacy ESG API mode. LLM Base URL, key, model,
# and prompt are configured in the in-app Admin panel and saved server-side.
ESG_API_ORIGIN=http://host.docker.internal:8913
ESG_API_TOKEN=
# Required to open the in-app Admin panel. Use a long, unique password.
NOOK_ADMIN_PASSWORD=change-this-before-starting
# Vercel: add whichever providers you want to expose in the front-end switch.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional custom OpenAI-compatible provider.
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_MODEL=
NOOK_SYSTEM_PROMPT=You are a helpful, concise assistant.
VITE_GITHUB_URL=https://github.com/CreateIntelligens
